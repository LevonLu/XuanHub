{
    "id": "netstat",
    "name": "Network",
    "version": "0.1.0",
    "author": "XuanHub",
    "settings": [
        { "group": "采集", "fields": [
            { "key": "intervalMs", "type": "int", "label": "刷新间隔 (ms)",
              "default": 1000, "min": 200, "max": 10000, "step": 100 }
        ]},
        { "group": "显示", "fields": [
            { "key": "downPrefix", "type": "string", "label": "下行前缀", "default": "↓ " },
            { "key": "upPrefix",   "type": "string", "label": "上行前缀", "default": "↑ " },
            { "key": "downColor",  "type": "color",  "label": "下行颜色", "default": "",
              "description": "留空跟随主题" },
            { "key": "upColor",    "type": "color",  "label": "上行颜色", "default": "",
              "description": "留空跟随主题" }
        ]}
    ]
}
