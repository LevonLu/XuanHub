{
  "id": "pixel_landscape",
  "name": "朝暮",
  "version": "0.3.0",
  "author": "XuanHub",
  "apiVersion": 2,
  "configVersion": 1,
  "minHostVersion": "0.4.0",
  "maxHostVersion": "0.x",
  "entry": {
    "backend": "pixel_landscape.dll",
    "qml": "PixelLandscape.qml",
    "settingsQml": "PixelLandscapeSettings.qml"
  },
  "capabilities": [
    "barItem",
    "settings",
    "popup"
  ],
  "permissions": [
    "storage.private"
  ],
  "compatibility": {
    "architecture": "x64",
    "qtVersion": "6.9.3",
    "compiler": "msvc2022",
    "crt": "dynamic"
  },
  "layout": {
    "region": "center",
    "minWidth": 160,
    "preferredWidth": 320,
    "maxWidth": 320,
    "flex": 0,
    "priority": 10,
    "overflow": "hide"
  },
  "settings": [
    {
      "group": "风景",
      "fields": [
        {
          "key": "scene",
          "type": "enum",
          "label": "场景",
          "default": "cabin",
          "options": [
            {
              "value": "cabin",
              "label": "山间小屋"
            },
            {
              "value": "lighthouse",
              "label": "海边灯塔"
            },
            {
              "value": "street",
              "label": "夜雨街角"
            },
            {
              "value": "campsite",
              "label": "湖畔营地"
            },
            {
              "value": "railway",
              "label": "田野铁道"
            },
            {
              "value": "island",
              "label": "空中浮岛"
            },
            {
              "value": "window_city",
              "label": "窗外城市"
            },
            {
              "value": "below_surface",
              "label": "水面以下"
            },
            {
              "value": "westward_journey",
              "label": "取经路上"
            }
          ]
        },
        {
          "key": "timeMode",
          "type": "enum",
          "label": "时段",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "跟随当地太阳"
            },
            {
              "value": "dawn",
              "label": "清晨"
            },
            {
              "value": "day",
              "label": "白天"
            },
            {
              "value": "dusk",
              "label": "黄昏"
            },
            {
              "value": "night",
              "label": "夜晚"
            }
          ]
        },
        {
          "key": "weather",
          "type": "enum",
          "label": "天气",
          "default": "clear",
          "options": [
            {
              "value": "clear",
              "label": "晴天"
            },
            {
              "value": "rain",
              "label": "小雨"
            },
            {
              "value": "snow",
              "label": "飘雪"
            }
          ]
        },
        {
          "key": "frameStyle",
          "type": "enum",
          "label": "画框样式",
          "default": "wood",
          "options": [
            {
              "value": "none",
              "label": "无画框"
            },
            {
              "value": "thin",
              "label": "极简细框"
            },
            {
              "value": "wood",
              "label": "暖木框"
            },
            {
              "value": "mat",
              "label": "白色卡纸框"
            },
            {
              "value": "metal",
              "label": "像素金属框"
            }
          ]
        },
        {
          "key": "goldenHourMode",
          "type": "enum",
          "label": "朝阳与晚霞",
          "default": "random",
          "options": [
            {
              "value": "random",
              "label": "随机出现（每天 1/3 概率）"
            },
            {
              "value": "always",
              "label": "每天出现"
            },
            {
              "value": "off",
              "label": "关闭"
            }
          ]
        },
        {
          "key": "animationsEnabled",
          "type": "bool",
          "label": "动态效果",
          "default": true
        },
        {
          "key": "rareEventsEnabled",
          "type": "bool",
          "label": "偶发流星",
          "default": true
        }
      ]
    },
    {
      "group": "地理位置",
      "fields": [
        {
          "key": "locationSource",
          "type": "enum",
          "label": "定位方式",
          "default": "system",
          "options": [
            {
              "value": "system",
              "label": "Windows 定位优先"
            },
            {
              "value": "manual",
              "label": "仅使用手动位置"
            }
          ]
        },
        {
          "key": "manualLocationEnabled",
          "type": "bool",
          "label": "启用手动位置（系统定位失败时备用）",
          "default": false
        },
        {
          "key": "latitude",
          "type": "double",
          "label": "纬度（北纬为正）",
          "default": 0,
          "min": -90,
          "max": 90,
          "decimals": 5,
          "enabledWhen": {
            "key": "manualLocationEnabled",
            "truthy": true
          }
        },
        {
          "key": "longitude",
          "type": "double",
          "label": "经度（东经为正）",
          "default": 0,
          "min": -180,
          "max": 180,
          "decimals": 5,
          "enabledWhen": {
            "key": "manualLocationEnabled",
            "truthy": true
          }
        }
      ]
    }
  ]
}
