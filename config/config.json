{
  "bar": { "height": 40, "edge": "top", "monitor": "primary", "opacity": 1.0, "themeId": "xuanhub-default", "theme": "dark", "mode": "appbar", "taskbarOffsetX": 0 },
  "plugins": [
    { "id": "sysinfo",  "position": "right", "order": 0, "config": { "intervalMs": 1000, "itemsPerColumn": 5, "items": [ { "metric": "cpu", "prefix": "CPU ", "color": "" }, { "metric": "mem", "prefix": "RAM ", "color": "" }, { "metric": "gpu", "prefix": "GPU ", "color": "" }, { "metric": "netDown", "prefix": "↓ ", "color": "" }, { "metric": "netUp", "prefix": "↑ ", "color": "" } ] } },
    { "id": "clock",    "position": "right", "order": 1, "config": { "format": "HH:mm:ss" } },
    { "id": "pybridge", "position": "right", "order": 9, "config": {} },
    { "id": "py_hello", "position": "right", "order": 2, "config": { "intervalMs": 1000, "prefix": "Py" } },
    { "id": "py_usage_hub", "position": "right", "order": 3, "config": { "intervalMs": 3000, "vendors": [] } },
    { "id": "py_heartrate", "position": "right", "order": 4, "config": { "intervalMs": 1000, "autoReconnect": true, "staleSeconds": 10 } },
    { "id": "py_intime", "position": "right", "order": 5, "config": { "intervalMs": 1000, "workSeconds": 1500, "restSeconds": 300 } },
    { "id": "py_countdown", "position": "right", "order": 6, "config": { "intervalMs": 1000, "mode": "每日重复", "targetTime": "18:00", "prefix": "下班", "suffix": "剩余", "reachedText": "下班啦🎉", "reachedColor": "" } },
    { "id": "py_todo", "position": "right", "order": 7, "config": { "intervalMs": 1000, "prefix": "📝", "barMode": "数量" } },
    { "id": "py_pet", "position": "right", "order": 8, "config": { "intervalMs": 1000, "petType": "猫", "petName": "宠物" } },
  ]
}
