{
    "id": "py_countdown",
    "name": "PyCountdown",
    "version": "0.2.0",
    "author": "XuanHub",
    "apiVersion": 2,
    "configVersion": 2,
    "capabilities": [
        "barItem",
        "settings"
    ],
    "permissions": [],
    "qml": "Countdown.qml",
    "settingsQml": "CountdownSettings.qml",
    "settings": [
        {
            "group": "目标时间",
            "fields": [
                {
                    "key": "mode",
                    "type": "enum",
                    "label": "目标模式",
                    "default": "daily",
                    "options": [
                        {
                            "value": "daily",
                            "label": "每日重复"
                        },
                        {
                            "value": "date",
                            "label": "指定日期"
                        }
                    ],
                    "description": "每日重复=每天到点归零；指定日期=倒数到某个一次性时刻"
                },
                {
                    "key": "targetTime",
                    "type": "string",
                    "label": "每日时刻",
                    "default": "18:00:00",
                    "placeholder": "HH:MM:SS",
                    "description": "「每日重复」模式用：每天到达的时刻（时:分:秒）"
                },
                {
                    "key": "targetDateTime",
                    "type": "string",
                    "label": "指定日期时刻",
                    "default": "",
                    "placeholder": "YYYY-MM-DD HH:MM:SS",
                    "description": "「指定日期」模式用：一次性目标时刻（秒可省）"
                }
            ]
        },
        {
            "group": "显示",
            "fields": [
                {
                    "key": "prefix",
                    "type": "string",
                    "label": "前缀",
                    "default": "下班"
                },
                {
                    "key": "suffix",
                    "type": "string",
                    "label": "后缀",
                    "default": "剩余"
                },
                {
                    "key": "reachedText",
                    "type": "string",
                    "label": "到点文字",
                    "default": "下班啦🎉",
                    "description": "倒计时归零后显示的文字"
                },
                {
                    "key": "reachedColor",
                    "type": "color",
                    "label": "到点颜色",
                    "default": "",
                    "description": "空 = 跟随主题成功色；非空须为 #hex 或 SVG 颜色名"
                }
            ]
        },
        {
            "group": "悬浮提示",
            "fields": [
                {
                    "key": "tooltipText",
                    "type": "string",
                    "multiline": true,
                    "label": "提示文本",
                    "default": "",
                    "description": "留空关闭；{payday} 为下次发薪日期，{paydayDays} 为剩余天数"
                },
                {
                    "key": "paydayDay",
                    "type": "int",
                    "label": "每月发薪日",
                    "default": 10,
                    "min": 1,
                    "max": 31,
                    "description": "遇休息日提前到最近工作日；短月取月末"
                },
                {
                    "key": "paydayHolidays",
                    "type": "string",
                    "label": "额外休息日",
                    "default": "",
                    "description": "YYYY-MM-DD，多个日期用逗号分隔；覆盖国家日历"
                },
                {
                    "key": "paydayWorkdays",
                    "type": "string",
                    "label": "额外工作日",
                    "default": "",
                    "description": "YYYY-MM-DD，多个日期用逗号分隔；覆盖国家日历"
                }
            ]
        },
        {
            "group": "刷新",
            "fields": [
                {
                    "key": "intervalMs",
                    "type": "int",
                    "label": "刷新间隔 (ms)",
                    "default": 1000,
                    "min": 200,
                    "max": 60000,
                    "step": 1000
                }
            ]
        }
    ]
}
