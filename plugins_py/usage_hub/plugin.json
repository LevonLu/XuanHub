{
    "id": "py_usage_hub",
    "name": "用量中心",
    "version": "1.0.0",
    "author": "XuanHub",
    "apiVersion": 2,
    "capabilities": ["barItem", "settings", "popup"],
    "permissions": [],
    "qml": "UsageHub.qml",
    "settingsQml": "UsageSettings.qml",
    "settings": [
        {
            "group": "厂商账户",
            "fields": [
                {
                    "key": "vendors",
                    "type": "array",
                    "itemKey": "secretId",
                    "items": {
                        "type": "object",
                        "fields": [
                            {"key": "apiKey", "type": "string", "secret": true}
                        ]
                    }
                }
            ]
        }
    ]
}
