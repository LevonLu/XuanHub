{
    "id": "py_heartrate",
    "name": "HeartRate",
    "version": "0.1.0",
    "author": "XuanHub",
    "apiVersion": 2,
    "python": {
        "version": ">=3.12,<4.0",
        "packages": [
            { "name": "bleak", "import": "bleak", "version": "*" }
        ]
    },
    "capabilities": ["barItem", "settings", "popup"],
    "permissions": [],
    "qml": "HeartRate.qml",
    "settings": [
        {
            "group": "连接",
            "fields": [
                {
                    "key": "intervalMs",
                    "type": "int",
                    "label": "刷新间隔 (ms)",
                    "default": 1000,
                    "min": 100,
                    "max": 60000,
                    "step": 100
                },
                {
                    "key": "autoReconnect",
                    "type": "bool",
                    "label": "启动时自动重连上次设备",
                    "default": true,
                    "description": "失联后也会自动重试（最多 3 次）"
                },
                {
                    "key": "staleSeconds",
                    "type": "int",
                    "label": "失联判定 (s)",
                    "default": 10,
                    "min": 5,
                    "max": 300,
                    "step": 5,
                    "description": "连接后超过该时长收不到心率数据即视为失联"
                },
                {
                    "key": "historyWindow",
                    "type": "enum",
                    "label": "默认曲线时长",
                    "options": ["1", "3", "5", "10", "30"],
                    "default": "5",
                    "description": "弹窗内历史曲线打开时的默认时间窗口（分钟）"
                }
            ]
        }
    ]
}
