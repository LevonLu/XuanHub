        {
          "key": "popupAgentMode",
          "type": "enum",
          "label": "显示范围",
          "default": "all",
          "description": "仅本周期有消耗时只显示 Token 总数大于 0 的工具；自定义模式仅显示勾选项。显示范围不改变总量统计和后台采集。",
          "options": [
            {
              "value": "all",
              "label": "自动显示全部"
            },
            {
              "value": "active",
              "label": "仅本周期有 Token 消耗"
            },
