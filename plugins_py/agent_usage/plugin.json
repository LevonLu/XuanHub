        {
          "key": "refreshSeconds",
          "type": "int",
          "label": "刷新间隔（秒）",
          "default": 300,
          "min": 60,
          "max": 3600
        },
        {
          "key": "includeAccount",
          "type": "bool",
          "label": "总量包含账号级来源",
          "description": "Cursor 和 TRAE Work CN 可能包含其他设备，默认仅在明细中展示。",
          "default": false
        },
        {
          "key": "showAll",
          "type": "bool",
          "label": "列出无记录的工具",
          "default": false
        },
        {
          "key": "quotaEnabled",
          "type": "bool",
          "label": "获取套餐额度",
          "description": "使用各工具已有登录状态访问额度接口，必要时刷新并保存过期凭据。",
          "default": true
        },
        {
          "key": "devinEnabled",
          "type": "bool",
          "label": "启用 Devin 额度查询",
          "default": false
        }
      ]
    },
    {
      "group": "点击后的工具列表",
