{
  "id": "glass-panel",
  "name": "Glass Panel",
  "version": "0.1.0",
  "author": "XuanHub",
  "dark": {
    "bg": "#11121bcc",
    "panel": "#202231cc",
    "fg": "#f2ecff",
    "muted": "#aaa4bd",
    "accent": "#c59cff",
    "danger": "#ff7a9e",
    "success": "#77d6a5",
    "warning": "#f0c36e",
    "hover": "#413b59e6",
    "border": "#6d648099",
    "onAccent": "#17121f"
  },
  "light": {
    "bg": "#f4f0f7e6",
    "panel": "#ffffffcc",
    "fg": "#272331",
    "muted": "#746d82",
    "accent": "#7951a8",
    "danger": "#b62f55",
    "success": "#2e8055",
    "warning": "#9b681b",
    "hover": "#e1d7eb",
    "border": "#bcb1c999",
    "onAccent": "#ffffff"
  },
  "appearance": {
    "window": {
      "outerPaddingX": 18,
      "outerPaddingY": 5
    },
    "bar": {
      "background": "bg",
      "opacity": 0.92,
      "radius": 12,
      "borderWidth": 1,
      "borderColor": "border"
    },
    "regions": {
      "decoration": "none",
      "paddingX": 4,
      "paddingY": 3,
      "spacing": 8
    },
    "items": {
      "decoration": "panel",
      "background": "panel",
      "hoverBackground": "hover",
      "opacity": 0.86,
      "radius": 6,
      "borderWidth": 1,
      "borderColor": "border",
      "paddingX": 7,
      "paddingY": 3,
      "spacing": 5
    },
    "typography": {
      "fontSize": 12,
      "fontWeight": 500
    },
    "motion": {
      "duration": 140
    }
  },
  "extension": {
    "type": "barChrome",
    "apiVersion": 1,
    "qml": "GlassPanelChrome.qml",
    "supports": ["appbar", "taskbar"]
  }
}
